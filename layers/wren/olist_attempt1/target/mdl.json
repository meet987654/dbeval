      ],
      "name": "order_reviews_orders_order_id"
    },
    {
      "condition": "products.product_category_name = product_category_name_translation.product_category_name",
      "joinType": "MANY_TO_ONE",
      "models": [
        "products",
        "product_category_name_translation"
      ],
      "name": "products_product_category_name_translation_product_category_name"
    }
  ],
  "views": [
    {
      "name": "order_payment_totals",
      "statement": "SELECT order_id, SUM(payment_value) AS total_payment_value FROM order_payments GROUP BY order_id",
      "properties": {
        "description": "Total payment value per order from order_payments."
      }
    },
    {
      "name": "product_categories_english",
      "statement": "SELECT p.product_id, COALESCE(t.product_category_name_english, p.product_category_name) AS category_name_english FROM products p LEFT JOIN product_category_name_translation t ON p.product_category_name = t.product_category_name WHERE p.product_category_name IS NOT NULL",
      "properties": {
        "description": "English category name with Portuguese fallback."
      }
    },
    {
      "name": "real_sales",
      "statement": "SELECT oi.*, o.customer_id, o.order_purchase_timestamp FROM order_items oi JOIN orders o ON oi.order_id = o.order_id WHERE o.order_status NOT IN ('canceled', 'unavailable')",
      "properties": {
        "description": "Real sales order items (excludes canceled and unavailable orders). Price is the sales amount."
      }
    }
  ],
  "dataSource": "postgres",
  "layoutVersion": 2
