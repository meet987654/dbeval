          "properties": {}
        }
      ],
      "primaryKey": "id",
      "cached": false,
      "properties": {
        "description": "Subscriptions table. Active subscription: status = 'active' on a real account (accounts.is_test = false AND accounts.deleted_at IS NULL). trialing and past_due are not active. Churn: status = 'canceled' AND cancel_reason IN ('voluntary', 'payment_failed') with canceled_at in period on a real account; cancel_reason = 'upgrade' is NOT churn."
