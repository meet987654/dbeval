  "views": [
    {
      "name": "active_subscriptions",
      "statement": "SELECT s.* FROM subscriptions s JOIN accounts a ON s.account_id = a.id WHERE s.status = 'active' AND a.is_test = false AND a.deleted_at IS NULL",
      "properties": {
        "description": "Active subscriptions: status = 'active' on real accounts. trialing and past_due are not active."
      }
    },
    {
      "name": "churn_subscriptions",
      "statement": "SELECT s.* FROM subscriptions s JOIN accounts a ON s.account_id = a.id WHERE s.status = 'canceled' AND s.cancel_reason IN ('voluntary', 'payment_failed') AND a.is_test = false AND a.deleted_at IS NULL",
      "properties": {
        "description": "Churn subscriptions: status = 'canceled' AND cancel_reason IN ('voluntary', 'payment_failed') on real accounts. upgrade is NOT churn."
      }
    },
    {
      "name": "paid_invoices",
      "statement": "SELECT i.* FROM invoices i JOIN accounts a ON i.account_id = a.id WHERE i.status = 'paid' AND a.is_test = false AND a.deleted_at IS NULL",
      "properties": {
        "description": "Paid invoices on real accounts. For gross revenue: SUM(amount_cents::numeric / 100 * fx_rates.usd_per_unit) with paid_at in period."
      }
    },
    {
      "name": "real_accounts",
      "statement": "SELECT * FROM accounts WHERE is_test = false AND deleted_at IS NULL",
      "properties": {
        "description": "Real accounts only: `is_test = false AND deleted_at IS NULL`. Never count test or deleted accounts."
      }
    },
    {
      "name": "real_users",
      "statement": "SELECT u.* FROM users u JOIN accounts a ON u.account_id = a.id WHERE u.deleted_at IS NULL AND a.is_test = false AND a.deleted_at IS NULL",
      "properties": {
        "description": "Real users only: `users.deleted_at IS NULL` belonging to a real account."
      }
    }
  ],
  "dataSource": "postgres",
  "layoutVersion": 2
