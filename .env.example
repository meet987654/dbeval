# Database URLs (connected as 'reader' for evaluation)
OLIST_DB_URL=postgresql://reader:reader@localhost:5433/olist
APPDB_DB_URL=postgresql://reader:reader@localhost:5433/appdb

# Postgres Admin (for seeding & migrations only)
POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/postgres

# LLM Configuration (Commercial APIs or Local Offline)
LLM_PROVIDER=mistral
LLM_MODEL=mistral-large-2512
OPENAI_BASE_URL=https://api.mistral.ai/v1
GOLD_MODEL_B=qwen/qwen3.8-27b

# API Keys (Required for commercial cloud APIs)
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Offline LLM Configuration (No API keys needed)
# Ollama:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5-coder:14b
# OLLAMA_BASE_URL=http://localhost:11434/v1
#
# vLLM:
# LLM_PROVIDER=vllm
# LLM_MODEL=Qwen/Qwen2.5-Coder-14B-Instruct
# VLLM_BASE_URL=http://localhost:8000/v1
#
# Optional LLM call timeout in seconds (default: 120.0)
# LLM_TIMEOUT=120.0
